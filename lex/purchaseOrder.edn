;; com.etzhayyim.yorosupply.purchaseOrder — lexicon (EDN form)
;; ADR-2605250850 · Phase 2 — order placement & scheduling
{:lexicon 1
 :id "com.etzhayyim.yorosupply.purchaseOrder"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["poId" "supplierDid" "materials" "deliveryDate" "state"]
    :properties
    {:poId          {:type "string" :description "purchase order ID"}
     :supplierDid   {:type "string" :description "supplier DID"}
     :materials     {:type "array"
                     :items {:type "object"
                             :properties {:name {:type "string"}
                                         :quantity {:type "integer"}
                                         :unit {:type "string"}}}
                     :description "BOM materials + quantities"}
     :deliveryDate  {:type "string" :description "ISO-8601 scheduled delivery"}
     :state         {:type "string" :description "draft|placed|confirmed|in-production|ready"}
     :supplierConsent {:type "string" :description "supplier DID-signed consent ref"}
     :timestamp     {:type "string" :description "ISO-8601 datetime"}}}}}}
